/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "feed",
	"vars": {
		"BLOG_INFO": {
			"TITLE": "snapps' snexy blog",
			"DESCRIPTION": "snakes and synths, servers and software, sniddy and snass, we got it all!",
			"ROOT": "http://127.0.0.1:8787",
			"AUTHOR": {
				"NAME": "snapps",
				"EMAIL": "lead.dumbass@snapps.dev"
			}
		}
	},
	"main": "src/index.ts",
	"compatibility_date": "2026-08-07",
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [{
		"binding": "BLOG_DB",
		"database_name": "temp-blog-db",
		"database_id": "04cf8ce2-8119-4378-bb68-c49aec69090b"
	}],
	"env": {
		"production": {
			"vars": {
				"BLOG_INFO": {
					"TITLE": "snapps' snexy blog",
					"DESCRIPTION": "snakes and synths, servers and software, sniddy and snass, we got it all!",
					"ROOT": "https://feed.snapps.dev",
					"AUTHOR": {
						"NAME": "snapps",
						"EMAIL": "lead.dumbass@snapps.dev"
					}
				}
			},
			"route": "feed.snapps.dev/*",
			"d1_databases": [{
				"binding": "BLOG_DB",
				"database_name": "blog-db",
				"database_id": "5a4520c5-70f0-4c61-ad2d-01e25f9c2540",
				"remote": true
			}],

		},
		"staging": {
			"vars": {
				"BLOG_INFO": {
					"TITLE": "snapps' snexy blog",
					"DESCRIPTION": "snakes and synths, servers and software, sniddy and snass, we got it all!",
					"ROOT": "https://feed-staging.snapples64.workers.dev",
					"AUTHOR": {
						"NAME": "snapps",
						"EMAIL": "lead.dumbass@snapps.dev"
					}
				}
			},
			"d1_databases": [{
				"binding": "BLOG_DB",
				"database_name": "blog-db",
				"database_id": "5a4520c5-70f0-4c61-ad2d-01e25f9c2540",
				"remote": true
			}],
		}
	}
}
